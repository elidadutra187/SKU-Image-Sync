NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_USER_AGENT=Imagem em Lote (seu-email@exemplo.com)
PORT=3000
APP_URL=https://imagememlote.onrender.com

# Suporte exclusivo deste app. Executar Apps Script pela conta Gmail autorizada.
SUPPORT_WEBHOOK_URL=
SUPPORT_WEBHOOK_SECRET=
# Destinatário fixo no código: elunalab@gmail.com

# Optional local/server settings
IMAGES_ROOT=./Fotos
NUVEMSHOP_API_VERSION=2025-03
NUVEMSHOP_REQUEST_DELAY_MS=900
OAUTH_TOKEN_FILE=.nuvemshop-oauth-token.json
DATABASE_URL=
DATABASE_SSL=true
SESSION_SECRET=
UPLOAD_SESSION_TTL_MS=21600000

# OAuth. Configure these with the values from Nuvemshop Partners.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_APP_SCOPES=read_products,write_products

# Cobrança única fixa da publicação, pela Nuvemshop. Não criar cobrança adicional.
NUVEMSHOP_BILLING_MODEL=platform_once
# Preço brasileiro atual. O receptor preserva BRL79,90 legado e o contrato ARS anterior.
NUVEMSHOP_ONE_TIME_PRICE=79.99
NUVEMSHOP_BILLING_CURRENCY=BRL
NUVEMSHOP_BILLING_CONCEPT=app-cost
# O fluxo adicional usage_once não é o fluxo publicado e permanece desativado.
NUVEMSHOP_NATIVE_BILLING=false

# Yampi: Mercado Pago exclusivo deste app. Nuvemshop permanece nativa.
# Deixe desabilitado até homologar com vendedor/comprador de teste.
YAMPI_MP_ENABLED=false
YAMPI_MP_MODE=test
YAMPI_MP_TEST_STORE_IDS=
YAMPI_MP_ACCESS_TOKEN=
YAMPI_MP_COLLECTOR_ID=
YAMPI_MP_APPLICATION_ID=
YAMPI_MP_WEBHOOK_SECRET=
# Só true após verificar que o token pertence a uma conta vendedora de teste.
YAMPI_MP_TEST_ACCOUNT_VERIFIED=false
# Habilitação real exige homologação e autorização específica.
YAMPI_MP_PRODUCTION_ENABLED=false
